<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SEVN_HOME</key>
		<string>/srv/sevn</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>bot.sevn.host</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/sevn/bin/sevn</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/srv/sevn/logs/service.log</string>
	<key>StandardOutPath</key>
	<string>/srv/sevn/logs/service.log</string>
</dict>
</plist>
