;; Workspace shell. Parameters: HOME, WORKSPACE, SHARED, NETWORK=on|off,
;; SEVN_DB, SEVN_DB_WAL, SEVN_DB_SHM, SEVN_DB_JOURNAL, SEVN_SECRETS,
;; SEVN_KEYS, SEVN_RUN, SEVN_LOGS, SEVN_HOME, SEVN_WORKSPACES.
(version 1)
(deny default)
(allow process-exec*)
(allow process-fork)
(allow signal (target self))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow ipc-posix*)
(allow system-socket)
(allow file-ioctl)
(allow file-read-metadata)
(allow file-map-executable)

;; Mach services: name lookup, logging and preferences, plus DNS and TLS trust.
;; The keychain (SecurityServer, secd), the pasteboard, Launch Services and
;; Apple Events stay out of reach, so a command cannot read secrets or ask
;; another app to run something outside the sandbox.
(allow mach-lookup
    (global-name "com.apple.system.opendirectoryd.libinfo")
    (global-name "com.apple.system.opendirectoryd.membership")
    (global-name "com.apple.system.notification_center")
    (global-name "com.apple.system.logger")
    (global-name "com.apple.logd")
    (global-name "com.apple.diagnosticd")
    (global-name "com.apple.cfprefsd.daemon")
    (global-name "com.apple.cfprefsd.agent")
    (global-name "com.apple.bsd.dirhelper")
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.dnssd.service")
    (global-name "com.apple.trustd")
    (global-name "com.apple.trustd.agent")
    (global-name "com.apple.analyticsd"))

;; Reads: the system, not the user's home, the sevn home, or other bots'
;; workspaces. This workspace, Shared, git's config and the usual toolchain
;; install paths are readable again below.
(allow file-read*)
(deny file-read* (subpath (param "HOME")))
(deny file-read* (subpath (param "SEVN_HOME")))
(deny file-read* (subpath (param "SEVN_WORKSPACES")))
(allow file-read*
    (subpath (param "WORKSPACE"))
    (subpath (param "SHARED"))
    (subpath (param "GIT_METADATA"))
    (literal (string-append (param "HOME") "/.gitconfig"))
    (subpath (string-append (param "HOME") "/.config/git"))
    (subpath (string-append (param "HOME") "/.local/bin"))
    (subpath (string-append (param "HOME") "/.local/share/uv"))
    (subpath (string-append (param "HOME") "/.local/share/pnpm"))
    (subpath (string-append (param "HOME") "/Library/pnpm"))
    (subpath (string-append (param "HOME") "/.cargo/bin"))
    (subpath (string-append (param "HOME") "/.rustup/toolchains"))
    (subpath (string-append (param "HOME") "/.nvm/versions"))
    (subpath (string-append (param "HOME") "/.pyenv/versions"))
    (subpath (string-append (param "HOME") "/.pyenv/shims"))
    (subpath (string-append (param "HOME") "/.bun/bin"))
    (subpath (string-append (param "HOME") "/.deno/bin"))
    (subpath (string-append (param "HOME") "/go/bin")))
;; Secret paths outside the home: keychains, CLI credentials, and the sevn home
;; (database, secrets, age key, run token, logs), which SEVN_HOME can move.
(deny file-read* (regex #"/\.ssh(/|$)"))
(deny file-read* (regex #"/\.aws(/|$)"))
(deny file-read* (regex #"/Library/Keychains(/|$)"))
(deny file-read* (regex #"/\.config/gh(/|$)"))
(deny file-read* (regex #"/\.config/opencode(/|$)"))
(deny file-read* (regex #"/\.codex(/|$)"))
(deny file-read* (regex #"/\.claude(/|$)"))
(deny file-read* (regex #"/\.config/claude(/|$)"))
(deny file-read* (literal (param "SEVN_DB")))
(deny file-read* (literal (param "SEVN_DB_WAL")))
(deny file-read* (literal (param "SEVN_DB_SHM")))
(deny file-read* (literal (param "SEVN_DB_JOURNAL")))
(deny file-read* (literal (param "SEVN_SECRETS")))
(deny file-read* (subpath (param "SEVN_KEYS")))
(deny file-read* (subpath (param "SEVN_RUN")))
(deny file-read* (subpath (param "SEVN_LOGS")))

(deny file-write*)
(allow file-write*
    (subpath (param "WORKSPACE"))
    (subpath (param "SHARED"))
    (subpath (param "GIT_METADATA"))
    (subpath "/dev"))
(deny file-write* (regex #"/\.ssh(/|$)"))
(deny file-write* (regex #"/\.aws(/|$)"))
(deny file-write* (regex #"/Library/Keychains(/|$)"))
(deny file-write* (regex #"/\.config/gh(/|$)"))
(deny file-write* (regex #"/\.config/opencode(/|$)"))
(deny file-write* (regex #"/\.codex(/|$)"))
(deny file-write* (regex #"/\.claude(/|$)"))
(deny file-write* (regex #"/\.config/claude(/|$)"))
(deny file-write* (literal (param "SEVN_DB")))
(deny file-write* (literal (param "SEVN_DB_WAL")))
(deny file-write* (literal (param "SEVN_DB_SHM")))
(deny file-write* (literal (param "SEVN_DB_JOURNAL")))
(deny file-write* (literal (param "SEVN_SECRETS")))
(deny file-write* (subpath (param "SEVN_KEYS")))
(deny file-write* (subpath (param "SEVN_RUN")))
(deny file-write* (subpath (param "SEVN_LOGS")))
(if (string=? (param "NETWORK") "on")
    (allow network*))
