;; Workspace shell. Parameters: WORKSPACE, SHARED, NETWORK=on|off,
;; SEVN_DB, SEVN_SECRETS, SEVN_KEYS, SEVN_RUN, SEVN_LOGS.
(version 1)
(deny default)
(allow process-exec*)
(allow process-fork)
(allow signal (target self))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix*)
(allow system-socket)
(allow file-ioctl)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read*)
(deny file-read* (regex #"/\.ssh(/|$)"))
(deny file-read* (regex #"/\.aws(/|$)"))
(deny file-read* (regex #"/Library/Keychains(/|$)"))
(deny file-read* (regex #"/\.config/gh(/|$)"))
(deny file-read* (regex #"/\.config/opencode(/|$)"))
(deny file-read* (regex #"/\.codex(/|$)"))
(deny file-read* (regex #"/\.claude(/|$)"))
(deny file-read* (regex #"/\.config/claude(/|$)"))
;; The host home holds the database, secrets, age key, run token and logs.
(deny file-read* (literal (param "SEVN_DB")))
(deny file-read* (literal (param "SEVN_DB_WAL")))
(deny file-read* (literal (param "SEVN_DB_SHM")))
(deny file-read* (literal (param "SEVN_DB_JOURNAL")))
(deny file-read* (literal (param "SEVN_SECRETS")))
(deny file-read* (subpath (param "SEVN_KEYS")))
(deny file-read* (subpath (param "SEVN_RUN")))
(deny file-read* (subpath (param "SEVN_LOGS")))
(deny file-write*)
(allow file-write*
    (subpath (param "WORKSPACE"))
    (subpath (param "SHARED"))
    (subpath "/dev"))
(deny file-write* (regex #"/\.ssh(/|$)"))
(deny file-write* (regex #"/\.aws(/|$)"))
(deny file-write* (regex #"/Library/Keychains(/|$)"))
(deny file-write* (regex #"/\.config/gh(/|$)"))
(deny file-write* (regex #"/\.config/opencode(/|$)"))
(deny file-write* (regex #"/\.codex(/|$)"))
(deny file-write* (regex #"/\.claude(/|$)"))
(deny file-write* (regex #"/\.config/claude(/|$)"))
(deny file-write* (literal (param "SEVN_DB")))
(deny file-write* (literal (param "SEVN_DB_WAL")))
(deny file-write* (literal (param "SEVN_DB_SHM")))
(deny file-write* (literal (param "SEVN_DB_JOURNAL")))
(deny file-write* (literal (param "SEVN_SECRETS")))
(deny file-write* (subpath (param "SEVN_KEYS")))
(deny file-write* (subpath (param "SEVN_RUN")))
(deny file-write* (subpath (param "SEVN_LOGS")))
(if (string=? (param "NETWORK") "on")
    (allow network*))
