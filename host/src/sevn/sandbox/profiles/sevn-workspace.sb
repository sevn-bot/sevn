;; Workspace shell. Parameters: WORKSPACE, SHARED, NETWORK=on|off.
(version 1)
(deny default)
(allow process-exec*)
(allow process-fork)
(allow signal (target self))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix*)
(allow system-socket)
(allow file-ioctl)
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read*)
(deny file-read* (regex #"/\.ssh(/|$)"))
(deny file-read* (regex #"/\.aws(/|$)"))
(deny file-read* (regex #"/Library/Keychains(/|$)"))
(deny file-read* (regex #"/\.config/gh(/|$)"))
(deny file-read* (regex #"/\.config/opencode(/|$)"))
(deny file-read* (regex #"/\.codex(/|$)"))
(deny file-read* (regex #"/\.claude(/|$)"))
(deny file-read* (regex #"/\.config/claude(/|$)"))
(deny file-write*)
(allow file-write*
    (subpath (param "WORKSPACE"))
    (subpath (param "SHARED"))
    (subpath "/dev"))
(deny file-write* (regex #"/\.ssh(/|$)"))
(deny file-write* (regex #"/\.aws(/|$)"))
(deny file-write* (regex #"/Library/Keychains(/|$)"))
(deny file-write* (regex #"/\.config/gh(/|$)"))
(deny file-write* (regex #"/\.config/opencode(/|$)"))
(deny file-write* (regex #"/\.codex(/|$)"))
(deny file-write* (regex #"/\.claude(/|$)"))
(deny file-write* (regex #"/\.config/claude(/|$)"))
(if (string=? (param "NETWORK") "on")
    (allow network*))
